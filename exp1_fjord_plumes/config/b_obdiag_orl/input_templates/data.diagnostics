# Exp. 1 (b) b_twoplume3d -- case ${case}
# MDS output (no MNC). Snapshots every 30 min (frequency < 0); ice-front
# fluxes averaged over 15 min so that face_total_melt can average over any
# window of whole quarter-hours. Diagnostic names: pkg/icefront/
# icefront_diagnostics_init.F:41,48 (ICFfwFlx kg m-2 s-1, < 0 = melt;
# ICFhtFlx W m-2). (b): VVEL added (3-D); snapshots are written one step
# late (pkg/diagnostics/diagnostics_write.F:62-72), so the t = endTime state
# is in the dumpInitAndLast state files and the pickup.
 &DIAGNOSTICS_LIST
  fields(1,1)  = 'THETA   ',
  fileName(1)  = 'THETA',
  frequency(1) = -1800.,
  timePhase(1) = 0.,
  fields(1,2)  = 'SALT    ',
  fileName(2)  = 'SALT',
  frequency(2) = -1800.,
  timePhase(2) = 0.,
  fields(1,3)  = 'UVEL    ',
  fileName(3)  = 'UVEL',
  frequency(3) = -1800.,
  timePhase(3) = 0.,
  fields(1,4)  = 'VVEL    ',
  fileName(4)  = 'VVEL',
  frequency(4) = -1800.,
  timePhase(4) = 0.,
  fields(1,5)  = 'WVEL    ',
  fileName(5)  = 'WVEL',
  frequency(5) = -1800.,
  timePhase(5) = 0.,
  fields(1,6)  = 'ETAN    ',
  fileName(6)  = 'ETAN',
  frequency(6) = -1800.,
  timePhase(6) = 0.,
  fields(1:2,7) = 'ICFfwFlx','ICFhtFlx',
  fileName(7)  = 'icefrontDiag',
  frequency(7) = 900.,
# --- R29 animation output (pkg/diagnostics; output only, the physics is
#     unchanged). Snapshots every 120 s. pkg/diagnostics can restrict the
#     vertical levels (levels(:,n), diagnostics_readparms.F:49,326-331) but
#     not a horizontal slice, so WVEL is written full 3-D (the ice-face y-z
#     section needs every level): 2.88 MB per snapshot. THETA only at levels
#     8 and 16 (1-based; cell centres z = -75 m in the outflow layer and
#     z = -155 m at mid-depth): 0.19 MB per snapshot.
  fields(1,8)  = 'WVEL    ',
  fileName(8)  = 'animW',
  frequency(8) = -120.,
  timePhase(8) = 0.,
  fields(1,9)  = 'THETA   ',
  fileName(9)  = 'animT',
  frequency(9) = -120.,
  timePhase(9) = 0.,
  levels(1:2,9) = 8., 16.,
 &

 &DIAG_STATIS_PARMS
 &
