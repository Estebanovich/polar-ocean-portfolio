 &PARM01
# --- linear EOS as config (a) (Jenkins 2011 Table 1)
 eosType='LINEAR',
 tAlpha=3.87E-5,
 sBeta=7.86E-4,
 rhoNil=1027.,
 rhoConst=1027.,
 HeatCapacity_Cp=3974.,
 gravity=9.81,
 tRef=10*2.,
 sRef=10*34.,
 viscAh=1.,
 viscAr=1.E-4,
# no tracer diffusion: with uniform T, S the only tracer tendency left in
# the sink cell is the addMass term itself (apply_forcing.F:505-527)
 diffKhT=0.,
 diffKrT=0.,
 diffKhS=0.,
 diffKrS=0.,
 implicitViscosity=.TRUE.,
 tempAdvScheme=33,
 saltAdvScheme=33,
 staggerTimeStep=.TRUE.,
 f0=0.,
 beta=0.,
 nonHydrostatic=.FALSE.,
 rigidLid=.FALSE.,
 implicitFreeSurface=.TRUE.,
 exactConserv=.TRUE.,
 selectAddFluid=1,
 readBinaryPrec=64,
 writeBinaryPrec=64,
 useSingleCpuIO=.TRUE.,
