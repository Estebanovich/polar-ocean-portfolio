# Exp. 1 (b) b_twoplume3d -- case ${case}
# Eastern open boundary at x = 1 km, as (a): Orlanski radiation + U/V
# sponge (thesis config verification/BayIW_Rectan/run_expand/data.obcs).
# OB_Ieast=-2 -> column Nx-1 (pkg/obcs/obcs_readparms.F:671-672); column Nx
# is land (cases.yaml land_i_cols) so that the periodic x-wrap closes the
# domain at the ice face (west face of column 1).
# (b): OB_Ieast is given for all Ny rows, including the two land rows
# Fortran j = 1, Ny = Python rows 0, Ny-1 (side walls). OBCS_CHECK (obcs_check.F:621-643) needs the
# inside mask = 0 at OB_Ie, true on land too, and demands an OB only where
# a wet U point leaves the inside mask, so the land rows are consistent.
# To be confirmed in the Step 2 log ("OBCS_CHECK ... OK").
# No north/south OB: the cross-fjord boundaries are closed walls.
# The 10-cell sponge is 100 m of the 990 m wet length.
# No useOBCSbalance: it balances only EmPmR, not addMass
# (pkg/obcs/obcs_balance_flow.F:300-315), and would trap the discharge.
 &OBCS_PARM01
 OB_Ieast=${ny}*-2,
 useOrlanskiEast=.TRUE.,
 useOBCSsponge=.TRUE.,
 OBCSsponge_Theta=.FALSE.,
 OBCSsponge_Salt=.FALSE.,
 OBCS_monitorFreq=3600.,
 &

 &OBCS_PARM02
 cvelTimeScale=250.,
 CMAX=0.45,
 &

 &OBCS_PARM03
 spongeThickness=10,
 Urelaxobcsinner=1200.,
 Vrelaxobcsinner=1200.,
 Urelaxobcsbound=60.,
 Vrelaxobcsbound=60.,
 &
