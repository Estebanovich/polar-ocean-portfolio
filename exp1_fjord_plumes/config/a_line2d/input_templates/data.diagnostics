# Exp. 1 (a) a_line2d -- case ${case}
# MDS output (no MNC). Snapshots every 1 h (frequency < 0); ice-front
# fluxes averaged over 1 h. Diagnostic names: pkg/icefront/
# icefront_diagnostics_init.F:41,48 (ICFfwFlx kg m-2 s-1, < 0 = melt;
# ICFhtFlx W m-2).
 &DIAGNOSTICS_LIST
  fields(1,1)  = 'THETA   ',
  fileName(1)  = 'THETA',
  frequency(1) = -3600.,
  timePhase(1) = 0.,
  fields(1,2)  = 'SALT    ',
  fileName(2)  = 'SALT',
  frequency(2) = -3600.,
  timePhase(2) = 0.,
  fields(1,3)  = 'UVEL    ',
  fileName(3)  = 'UVEL',
  frequency(3) = -3600.,
  timePhase(3) = 0.,
  fields(1,4)  = 'WVEL    ',
  fileName(4)  = 'WVEL',
  frequency(4) = -3600.,
  timePhase(4) = 0.,
  fields(1,5)  = 'ETAN    ',
  fileName(5)  = 'ETAN',
  frequency(5) = -3600.,
  timePhase(5) = 0.,
  fields(1:2,6) = 'ICFfwFlx','ICFhtFlx',
  fileName(6)  = 'icefrontDiag',
  frequency(6) = 3600.,
 &

 &DIAG_STATIS_PARMS
 &
