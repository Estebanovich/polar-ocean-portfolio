# tutorial_reentrant_channel/input/data.layers, bounds extended to -4..12 degC for the seasonal
# SST relaxation (-3.5..11.5 degC).
 &LAYERS_PARM01
 layers_name(1) ='TH',
 layers_bounds(1:44,1)= -4.00, -3.50, -3.00, -2.50,
                        -2.00, -1.75, -1.50, -1.25,
                        -1.00, -0.75, -0.50, -0.25,
                         0.00,  0.25,  0.50,  0.75,
                         1.00,  1.25,  1.50,  1.75,
                         2.00,  2.25,  2.50,  2.75,
                         3.00,  3.25,  3.50,  3.75,
                         4.00,  4.25,  4.50,   5.0,
                         5.5,    6.0,   6.5,   7.0,
                         7.5,    8.0,   8.5,   9.0,
                         9.5,   10.0,  11.0,  12.0,
 &
