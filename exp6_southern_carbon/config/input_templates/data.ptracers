# Tracers 1-5 as verification/tutorial_global_oce_biogeo/input/data.ptracers; 6 = preformed PO4
# (reset to PO4 in the top level each step, code/gchem_forcing_sep.F, block EXP6). Vertical
# diffusivity = diffKrT of the physics (data), so heat and carbon mix alike.
 &PTRACERS_PARM01
 PTRACERS_numInUse=6,
 PTRACERS_Iter0= 0,
 PTRACERS_names(1)='DIC',
 PTRACERS_long_names(1)='Dissolved Inorganic Carbon (DIC) [mol C/m^3]',
 PTRACERS_units(1)='mol/m^3',
 PTRACERS_advScheme(1)=77,
 PTRACERS_diffKh(1)=0.,
 PTRACERS_diffKr(1)=1.E-5,
 PTRACERS_useGMRedi(1)=${ptr_gm},
 PTRACERS_initialFile(1)='init_ptr1.bin',
 PTRACERS_EvPrRn(1)=0.,
 PTRACERS_names(2)='Alk',
 PTRACERS_long_names(2)='Alkalinity (Alk) [mol eq/m^3]',
 PTRACERS_units(2)='mol/m^3',
 PTRACERS_advScheme(2)=77,
 PTRACERS_diffKh(2)=0.,
 PTRACERS_diffKr(2)=1.E-5,
 PTRACERS_useGMRedi(2)=${ptr_gm},
 PTRACERS_initialFile(2)='init_ptr2.bin',
 PTRACERS_EvPrRn(2)=0.,
 PTRACERS_names(3)='PO4',
 PTRACERS_long_names(3)='Phosphate (PO4) [mol P/m^3]',
 PTRACERS_units(3)='mol/m^3',
 PTRACERS_advScheme(3)=77,
 PTRACERS_diffKh(3)=0.,
 PTRACERS_diffKr(3)=1.E-5,
 PTRACERS_useGMRedi(3)=${ptr_gm},
 PTRACERS_initialFile(3)='init_ptr3.bin',
 PTRACERS_EvPrRn(3)=0.,
 PTRACERS_names(4)='DOP',
 PTRACERS_long_names(4)='Dissolved Organic Phosphorus (DOP) [mol P/m^3]',
 PTRACERS_units(4)='mol/m^3',
 PTRACERS_advScheme(4)=77,
 PTRACERS_diffKh(4)=0.,
 PTRACERS_diffKr(4)=1.E-5,
 PTRACERS_useGMRedi(4)=${ptr_gm},
 PTRACERS_initialFile(4)='init_ptr4.bin',
 PTRACERS_EvPrRn(4)=0.,
 PTRACERS_names(5)='O2',
 PTRACERS_long_names(5)='Dissolved Oxygen (O2) [mol O/m^3]',
 PTRACERS_units(5)='mol/m^3',
 PTRACERS_advScheme(5)=77,
 PTRACERS_diffKh(5)=0.,
 PTRACERS_diffKr(5)=1.E-5,
 PTRACERS_useGMRedi(5)=${ptr_gm},
 PTRACERS_initialFile(5)='init_ptr5.bin',
 PTRACERS_EvPrRn(5)=0.,
 PTRACERS_names(6)='PO4pre',
 PTRACERS_long_names(6)='Preformed phosphate (PO4pre) [mol P/m^3]',
 PTRACERS_units(6)='mol/m^3',
 PTRACERS_advScheme(6)=77,
 PTRACERS_diffKh(6)=0.,
 PTRACERS_diffKr(6)=1.E-5,
 PTRACERS_useGMRedi(6)=${ptr_gm},
 PTRACERS_initialFile(6)='init_ptr6.bin',
 PTRACERS_EvPrRn(6)=0.,
 &
