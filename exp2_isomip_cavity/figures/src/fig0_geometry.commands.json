 {
  "command": "text.create",
  "params": {
   "x": 66,
   "y": 542.0,
   "text": "Rotation: the domain is an f-plane at 75\u00b0 S (f < 0). In most ISOMIP+ Ocean1 models the cavity holds a cyclonic (clockwise from above) circulation,",
   "size": 9.5,
   "font": "Helvetica",
   "color": "#222222"
  }
 },
 {
  "command": "text.create",
  "params": {
   "x": 66,
   "y": 555.0,
   "text": "intensified along the side at y > 50 km (Yung et al., 2026); the arrows, including the outflow along the y = 80 km wall, sketch that published pattern, not our output.",
   "size": 9.5,
   "font": "Helvetica",
   "color": "#222222"
  }
 },
 {
  "command": "text.create",
  "params": {
   "x": 40,
   "y": 576.0,
   "text": "Rendered with Blender from the ISOMIP+ input geometry (Cornford and Asay-Davis, 2016) on its 1 km grid; vertical exaggeration \u00d7100. The geometry is symmetric about y = 40 km:",
   "size": 9,
   "font": "Helvetica",
   "color": "#555555"
  }
 },
 {
  "command": "text.create",
  "params": {
   "x": 40,
   "y": 588.0,
   "text": "the near half (y = 0\u201340 km) is cut away along the centreline and drawn in outline. Arrows and the tracer layer are enlarged; the grounded ice is drawn capped at 200 m above sea level.",
   "size": 9,
   "font": "Helvetica",
   "color": "#555555"
  }
 }
